# Cloudflare Turnstile site key (public). Create at https://dash.cloudflare.com -> Turnstile.
# Copy this file to .env.local for local dev; set it in Vercel -> Project -> Environment Variables for production.
# Also add the Turnstile secret key in the Web3Forms dashboard (Form settings -> Captcha).
VITE_TURNSTILE_SITE_KEY=
